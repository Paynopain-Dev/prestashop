# Files excluded from "git archive" and from GitHub's "Download ZIP" / release archives.
# They are development-only and must never reach a merchant's shop.
/bin            export-ignore
/tests          export-ignore
/dist           export-ignore
/.idea          export-ignore
/.github        export-ignore
/phpunit.xml    export-ignore
/phpunit.xml.dist export-ignore
/.gitignore     export-ignore
/.gitattributes export-ignore
